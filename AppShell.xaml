<Shell
    x:Class="AstroBoy.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AstroBoy.Views.VAdmin">

    <FlyoutItem Title="Dashboard">
        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate views:AdminDashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Users">
        <ShellContent
            Title="Manage Users"
            ContentTemplate="{DataTemplate views:AdminUserPage}" />
    </FlyoutItem>

</Shell>