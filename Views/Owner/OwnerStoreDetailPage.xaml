<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:utils="clr-namespace:AstroBoy.Utils"
             x:Class="AstroBoy.Views.Owner.OwnerStoreDetailPage"
             Title="{Binding Store.Name}">
    <ContentPage.Resources>
        <utils:ItemImageConverter x:Key="ItemImageConverter" />
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="16,16,16,8" Spacing="4">
            <Label Text="{Binding Store.Address}" TextColor="Gray" FontSize="13" />
            <Label Text="{Binding Store.Phone}" TextColor="Gray" FontSize="13" />
            <Button Text="+ Tambah Item" Clicked="OnAddItemClicked" HorizontalOptions="Start" Margin="0,8,0,0" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" Margin="16,0">
            <CollectionView.EmptyView>
                <Label Text="Belum ada item." HorizontalOptions="Center" TextColor="Gray" Margin="0,32" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,4" StrokeShape="RoundRectangle 8">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <Image Grid.Column="0"
                                   Source="{Binding Id, Converter={StaticResource ItemImageConverter}}"
                                   WidthRequest="72" HeightRequest="72"
                                   Aspect="AspectFill"
                                   VerticalOptions="Center">
                                <Image.Clip>
                                    <RoundRectangleGeometry Rect="0,0,72,72" CornerRadius="8" />
                                </Image.Clip>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" />
                                <Label Text="{Binding Price, StringFormat='Rp {0:N0}'}" FontSize="13" />
                                <Label Text="{Binding Stock, StringFormat='Stok: {0}'}" FontSize="13" TextColor="Gray" />
                                <Label Text="{Binding Category}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="Edit" VerticalOptions="Center" Margin="4,0"
                                    Clicked="OnEditItemClicked" CommandParameter="{Binding .}" />
                            <Button Grid.Column="3" Text="Hapus" VerticalOptions="Center"
                                    BackgroundColor="#E74C3C" TextColor="White"
                                    Clicked="OnDeleteItemClicked" CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
