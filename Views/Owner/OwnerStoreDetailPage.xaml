<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:utils="clr-namespace:AstroBoy.Utils"
             x:Class="AstroBoy.Views.Owner.OwnerStoreDetailPage"
             Title="{Binding Store.Name}"
             BackgroundColor="#F8F9FF">

    <ContentPage.Resources>
        <utils:ItemImageConverter x:Key="ItemImageConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ── Store Info Header ───────────────────────────────────────── -->
        <Border Grid.Row="0"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="20,16,20,20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,24,24"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.06"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <!-- Store Icon -->
                <Border Grid.Column="0"
                        BackgroundColor="#EEF2FF"
                        StrokeThickness="0"
                        WidthRequest="54"
                        HeightRequest="54">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Label Text="🏪"
                           FontSize="26"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <!-- Info -->
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Text="{Binding Store.Address}"
                           FontSize="13"
                           TextColor="#6B7280"
                           LineBreakMode="TailTruncation"/>
                    <Label Text="{Binding Store.Phone}"
                           FontSize="12"
                           TextColor="#9CA3AF"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- ── Section Header: Items Count + Add Button ────────────────── -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              Padding="20,16,20,8">

            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="Daftar Item"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="#1F2937"/>
                <Label Text="{Binding Items.Count, StringFormat='{0} produk tersedia'}"
                       FontSize="12"
                       TextColor="#6B7280"/>
            </VerticalStackLayout>

            <Border Grid.Column="1"
                    BackgroundColor="#3E64FF"
                    StrokeThickness="0"
                    Padding="14,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddItemClicked"/>
                </Border.GestureRecognizers>
                <Label Text="+ Tambah Item"
                       TextColor="White"
                       FontSize="13"
                       FontAttributes="Bold"/>
            </Border>
        </Grid>

        <!-- ── Item List ───────────────────────────────────────────────── -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Items}"
                        Margin="16,0,16,0">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="10"
                                     Margin="0,48">
                    <Label Text="📦"
                           FontSize="56"
                           HorizontalOptions="Center"/>
                    <Label Text="Belum ada item"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1F2937"
                           HorizontalOptions="Center"/>
                    <Label Text="Tambahkan produk ke toko ini"
                           FontSize="13"
                           TextColor="#6B7280"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Header>
                <BoxView HeightRequest="4" Color="Transparent"/>
            </CollectionView.Header>
            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent"/>
            </CollectionView.Footer>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,2"
                                    Radius="8"
                                    Opacity="0.07"/>
                        </Border.Shadow>

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="0">

                            <!-- Item Info Row -->
                            <Grid Grid.Row="0"
                                  ColumnDefinitions="76,*"
                                  ColumnSpacing="12"
                                  Padding="12,12,12,10">

                                <!-- Product Image -->
                                <Border Grid.Column="0"
                                        StrokeThickness="0"
                                        WidthRequest="72"
                                        HeightRequest="72">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Image Source="{Binding Id, Converter={StaticResource ItemImageConverter}}"
                                           Aspect="AspectFill"
                                           BackgroundColor="#F3F4F6"/>
                                </Border>

                                <!-- Item Details -->
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#1F2937"
                                           LineBreakMode="TailTruncation"/>

                                    <Label Text="{Binding Price, StringFormat='Rp {0:N0}'}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#3E64FF"/>

                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                        <!-- Stock Badge -->
                                        <Border Grid.Column="0"
                                                BackgroundColor="#F0FDF4"
                                                StrokeThickness="0"
                                                Padding="8,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Stock, StringFormat='📦 {0} stok'}"
                                                   FontSize="11"
                                                   TextColor="#16A34A"/>
                                        </Border>

                                        <!-- Category Badge -->
                                        <Border Grid.Column="1"
                                                BackgroundColor="#EEF2FF"
                                                StrokeThickness="0"
                                                Padding="8,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Category}"
                                                   FontSize="11"
                                                   TextColor="#3E64FF"
                                                   LineBreakMode="TailTruncation"/>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Action Buttons Row -->
                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,Auto,Auto"
                                  Padding="12,0,12,12">

                                <BoxView Grid.ColumnSpan="3"
                                         HeightRequest="1"
                                         BackgroundColor="#F3F4F6"
                                         VerticalOptions="Start"
                                         Margin="0,0,0,10"/>

                                <Label Grid.Column="0" Text="" />

                                <Button Grid.Column="1"
                                        Text="Edit"
                                        Clicked="OnEditItemClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#EEF2FF"
                                        TextColor="#3E64FF"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        CornerRadius="10"
                                        HeightRequest="36"
                                        Padding="16,0"
                                        Margin="0,0,8,0"/>

                                <Button Grid.Column="2"
                                        Text="Hapus"
                                        Clicked="OnDeleteItemClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#FEE2E2"
                                        TextColor="#EF4444"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        CornerRadius="10"
                                        HeightRequest="36"
                                        Padding="16,0"/>
                            </Grid>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
