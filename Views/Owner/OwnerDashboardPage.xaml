<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AstroBoy.Views.Owner.OwnerDashboardPage"
             Title="Owner Dashboard">

    <VerticalStackLayout Padding="16" Spacing="12">

        <Label Text="{Binding WelcomeMessage}"
               FontSize="20"
               FontAttributes="Bold" />

        <Border Padding="16" StrokeShape="RoundRectangle 12" BackgroundColor="#EEF6FF">
            <VerticalStackLayout Spacing="4">
                <Label Text="Saldo Anda"
                       FontSize="13"
                       TextColor="Gray" />
                <Label Text="{Binding BalanceFormatted}"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#1A73E8" />
            </VerticalStackLayout>
        </Border>

        <Label Text="Toko Anda"
               FontSize="16"
               TextColor="Gray" />

        <Button Text="+ Tambah Toko"
                Clicked="OnAddStoreClicked"
                HorizontalOptions="Start" />

        <CollectionView ItemsSource="{Binding Stores}">
            <CollectionView.EmptyView>
                <Label Text="Belum ada toko. Tambahkan toko pertama Anda!"
                       HorizontalOptions="Center"
                       TextColor="Gray"
                       Margin="0,32" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,4" StrokeShape="RoundRectangle 8">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" RowSpacing="8">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnStoreTapped"
                                                          CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="16" />
                                <Label Text="{Binding Address}"
                                       FontSize="13"
                                       TextColor="Gray" />
                                <Label Text="{Binding Phone}"
                                       FontSize="13"
                                       TextColor="Gray" />
                            </VerticalStackLayout>
                            <Button Grid.Row="1" Grid.Column="1" Text="Edit" VerticalOptions="Center" Margin="4,0"
                                    Clicked="OnEditStoreClicked" CommandParameter="{Binding .}" />
                            <Button Grid.Row="1" Grid.Column="2" Text="Hapus" VerticalOptions="Center"
                                    BackgroundColor="#E74C3C" TextColor="White"
                                    Clicked="OnDeleteStoreClicked" CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>

</ContentPage>