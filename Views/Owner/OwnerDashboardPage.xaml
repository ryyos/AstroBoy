<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AstroBoy.Views.Owner.OwnerDashboardPage"
             Title="Owner Dashboard"
             BackgroundColor="#F8F9FF">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Header: Welcome + Balance Card ─────────────────────────── -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                Padding="20,48,20,28">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,28,28"/>
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#3E64FF" Offset="0"/>
                    <GradientStop Color="#5B7FFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <VerticalStackLayout Spacing="16">

                <!-- Greeting -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Selamat datang 👋"
                           FontSize="14"
                           TextColor="#C7D9FF"/>
                    <Label Text="{Binding WelcomeMessage}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"/>
                </VerticalStackLayout>

                <!-- Balance Chip -->
                <Border BackgroundColor="#F8F9FF"
                        StrokeThickness="1"
                        Stroke="#F8F9FF"
                        Padding="16,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="💰 Saldo Anda"
                                   FontSize="12"
                                   TextColor="#1F2937"/>
                            <Label Text="{Binding BalanceFormatted}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="#1F2937"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </Border>

        <!-- ── Body: Store List ────────────────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,32" Spacing="0">
                <!-- Section Header -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Toko Saya"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#1F2937"/>
                        <Label Text="{Binding Stores.Count, StringFormat='{0} toko terdaftar'}"
                               FontSize="13"
                               TextColor="#6B7280"/>
                    </VerticalStackLayout>

                    <!-- Add Store Button -->
                    <Border Grid.Column="1"
                            BackgroundColor="#3E64FF"
                            StrokeThickness="0"
                            Padding="14,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAddStoreClicked"/>
                        </Border.GestureRecognizers>
                        <Label Text="+ Tambah Toko"
                               TextColor="White"
                               FontSize="13"
                               FontAttributes="Bold"/>
                    </Border>
                </Grid>

                <!-- Store List -->
                <CollectionView ItemsSource="{Binding Stores}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="10"
                                             Margin="0,48">
                            <Label Text="🏪"
                                   FontSize="56"
                                   HorizontalOptions="Center"/>
                            <Label Text="Belum ada toko"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#1F2937"
                                   HorizontalOptions="Center"/>
                            <Label Text="Tambahkan toko pertama Anda!"
                                   FontSize="13"
                                   TextColor="#6B7280"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="White"
                                    StrokeThickness="0"
                                    Margin="0,0,0,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#000000"
                                            Offset="0,2"
                                            Radius="8"
                                            Opacity="0.07"/>
                                </Border.Shadow>

                                <Grid RowDefinitions="Auto,Auto" RowSpacing="0">

                                    <!-- Tap area (store info) -->
                                    <Grid Grid.Row="0"
                                          ColumnDefinitions="Auto,*"
                                          ColumnSpacing="14"
                                          Padding="16,16,16,12">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnStoreTapped"
                                                                  CommandParameter="{Binding .}"/>
                                        </Grid.GestureRecognizers>

                                        <!-- Store Icon -->
                                        <Border Grid.Column="0"
                                                BackgroundColor="#EEF2FF"
                                                StrokeThickness="0"
                                                WidthRequest="50"
                                                HeightRequest="50">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <Label Text="🏪"
                                                   FontSize="24"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <!-- Store Info -->
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="3"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#1F2937"/>
                                            <Label Text="{Binding Address}"
                                                   FontSize="13"
                                                   TextColor="#6B7280"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding Phone}"
                                                   FontSize="12"
                                                   TextColor="#9CA3AF"/>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Separator -->
                                    <BoxView Grid.Row="0"
                                             HeightRequest="1"
                                             BackgroundColor="#F3F4F6"
                                             VerticalOptions="End"
                                             Margin="16,0"/>

                                    <!-- Action Buttons -->
                                    <Grid Grid.Row="1"
                                          ColumnDefinitions="*,Auto,Auto"
                                          Padding="16,10,16,14">

                                        <Label Grid.Column="0"
                                               Text="Ketuk untuk lihat item →"
                                               FontSize="12"
                                               TextColor="#9CA3AF"
                                               VerticalOptions="Center"/>

                                        <Button Grid.Column="1"
                                                Text="Edit"
                                                Clicked="OnEditStoreClicked"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#EEF2FF"
                                                TextColor="#3E64FF"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                CornerRadius="10"
                                                HeightRequest="36"
                                                Padding="14,0"
                                                Margin="0,0,8,0"/>

                                        <Button Grid.Column="2"
                                                Text="Hapus"
                                                Clicked="OnDeleteStoreClicked"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FEE2E2"
                                                TextColor="#EF4444"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                CornerRadius="10"
                                                HeightRequest="36"
                                                Padding="14,0"/>
                                    </Grid>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
