<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AstroBoy.Views.VCustomer.ProfilePage"
             Title="Profile"
             BackgroundColor="#F8F9FF">

    <Grid>
        <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- ── Avatar + Nama + Email ──────────────────────────────── -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,16,0,8">

                <!-- Avatar bulat dengan border putih -->
                <Border WidthRequest="100"
                        HeightRequest="100"
                        StrokeThickness="3"
                        Stroke="White"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="50"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#AAAAAA" Offset="0,3" Radius="8" Opacity="0.25"/>
                    </Border.Shadow>
                    <Image Source="{Binding Avatar}" Aspect="AspectFill"/>
                </Border>

                <!-- Nama customer -->
                <Label Text="{Binding Name}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#1F2937"
                       HorizontalOptions="Center"
                       Margin="0,8,0,0"/>

                <!-- Email -->
                <Label Text="{Binding Email}"
                       FontSize="14"
                       TextColor="#6B7280"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- ── Card Saldo ─────────────────────────────────────────── -->
            <Border StrokeThickness="0" Padding="24" Margin="0,4,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3E64FF" Offset="0"/>
                        <GradientStop Color="#5B7FFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Saldo Saya"
                           TextColor="White"
                           FontSize="13"/>
                    <Label Text="{Binding BalanceFormatted}"
                           TextColor="White"
                           FontSize="28"
                           FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Border>

            <!-- ── Tombol Top Up Saldo ────────────────────────────────── -->
            <Button Text="+ Top Up Saldo"
                    Command="{Binding TopUpCommand}"
                    BackgroundColor="#22C55E"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="15"
                    CornerRadius="12"
                    HeightRequest="48"
                    Margin="0,0,0,4"/>

            <!-- ── Info: Nama Lengkap ─────────────────────────────────── -->
            <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Nama Lengkap"
                           FontSize="12"
                           TextColor="#6B7280"/>
                    <Label Text="{Binding Name}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#1F2937"/>
                </VerticalStackLayout>
            </Border>

            <!-- ── Info: Email ────────────────────────────────────────── -->
            <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Email"
                           FontSize="12"
                           TextColor="#6B7280"/>
                    <Label Text="{Binding Email}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#1F2937"/>
                </VerticalStackLayout>
            </Border>

            <!-- ── Info: Role ─────────────────────────────────────────── -->
            <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Role"
                           FontSize="12"
                           TextColor="#6B7280"/>
                    <Label Text="{Binding Role}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#1F2937"/>
                </VerticalStackLayout>
            </Border>

            <!-- ── Shortcut: Riwayat Pesanan ──────────────────────────── -->
            <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToOrderHistoryCommand}"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Riwayat Pesanan"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#3E64FF"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text=""
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#3E64FF"
                           VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- ── Tombol Logout ──────────────────────────────────────── -->
            <Button Text="LOGOUT"
                    BackgroundColor="#EF4444"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="52"
                    Margin="0,8,0,24"
                    Command="{Binding LogoutCommand}"/>

        </VerticalStackLayout>
        </ScrollView>

        <!-- ══════════════════════════════════════════════════════════
             OVERLAY: Top Up Saldo
        ══════════════════════════════════════════════════════════════ -->
        <Grid IsVisible="{Binding IsTopUpVisible}"
              BackgroundColor="#CC000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding HideTopUpCommand}"/>
            </Grid.GestureRecognizers>

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    Margin="24,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,6" Radius="24" Opacity="0.15"/>
                </Border.Shadow>
                <!-- absorb tap agar tidak menutup overlay saat tap kartu -->
                <Border.GestureRecognizers>
                    <TapGestureRecognizer/>
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="0" Padding="24">

                    <!-- Title -->
                    <Label Text="Top Up Saldo"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1F2937"
                           HorizontalOptions="Center"/>

                    <!-- Saldo saat ini -->
                    <Label Text="{Binding BalanceFormatted}"
                           FontSize="13"
                           TextColor="#3E64FF"
                           HorizontalOptions="Center"
                           Margin="0,4,0,20"/>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" BackgroundColor="#F3F4F6" Margin="0,0,0,16"/>

                    <!-- Label pilihan cepat -->
                    <Label Text="Pilih Nominal Cepat"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#6B7280"
                           Margin="0,0,0,10"/>

                    <!-- Quick amounts 2×2 -->
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="10"
                          Margin="0,0,0,20">
                        <Button Grid.Row="0" Grid.Column="0"
                                Text="Rp 50.000"
                                Command="{Binding SelectQuickAmountCommand}"
                                CommandParameter="50000"
                                BackgroundColor="#EEF2FF"
                                TextColor="#3E64FF"
                                FontSize="13"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="46"/>
                        <Button Grid.Row="0" Grid.Column="1"
                                Text="Rp 100.000"
                                Command="{Binding SelectQuickAmountCommand}"
                                CommandParameter="100000"
                                BackgroundColor="#EEF2FF"
                                TextColor="#3E64FF"
                                FontSize="13"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="46"/>
                        <Button Grid.Row="1" Grid.Column="0"
                                Text="Rp 200.000"
                                Command="{Binding SelectQuickAmountCommand}"
                                CommandParameter="200000"
                                BackgroundColor="#EEF2FF"
                                TextColor="#3E64FF"
                                FontSize="13"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="46"/>
                        <Button Grid.Row="1" Grid.Column="1"
                                Text="Rp 500.000"
                                Command="{Binding SelectQuickAmountCommand}"
                                CommandParameter="500000"
                                BackgroundColor="#EEF2FF"
                                TextColor="#3E64FF"
                                FontSize="13"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="46"/>
                    </Grid>

                    <!-- Label input manual -->
                    <Label Text="Atau masukkan nominal lain:"
                           FontSize="12"
                           TextColor="#3E64FF"
                           Margin="0,0,0,8"/>

                    <!-- Entry manual -->
                    <Border BackgroundColor="#F9FAFB"
                            Stroke="#E5E7EB"
                            StrokeThickness="1.5"
                            Padding="14,0"
                            Margin="0,0,0,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry Text="{Binding ManualAmount, Mode=TwoWay}"
                               Placeholder="Contoh: 150000"
                               Keyboard="Numeric"
                               HeightRequest="46"
                               FontSize="15"
                               BackgroundColor="Transparent"
                               TextColor="#1F2937"
                               PlaceholderColor="#9CA3AF"/>
                    </Border>

                    <!-- Error message -->
                    <Label Text="{Binding TopUpError}"
                           IsVisible="{Binding HasTopUpError}"
                           TextColor="#EF4444"
                           FontSize="12"
                           Margin="4,0,0,10"/>

                    <!-- Confirm button -->
                    <Button Text="Konfirmasi Top Up"
                            Command="{Binding ConfirmTopUpCommand}"
                            BackgroundColor="#22C55E"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="12"
                            HeightRequest="50"
                            Margin="0,8,0,8"/>

                    <!-- Cancel button -->
                    <Button Text="Batal"
                            Command="{Binding HideTopUpCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#6B7280"
                            FontSize="14"
                            HeightRequest="40"
                            Margin="0,0,0,4"/>

                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>