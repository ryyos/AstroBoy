<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AstroBoy.Views.VCustomer.ProfilePage"
             Title="Profile"
             BackgroundColor="#F8F9FF">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- ── Avatar + Nama + Email ──────────────────────────────── -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,16,0,8">

                <!-- Avatar bulat dengan border putih -->
                <Border WidthRequest="100"
                        HeightRequest="100"
                        StrokeThickness="3"
                        Stroke="White"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="50"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#AAAAAA" Offset="0,3" Radius="8" Opacity="0.25"/>
                    </Border.Shadow>
                    <Image Source="{Binding Avatar}" Aspect="AspectFill"/>
                </Border>

                <!-- Nama customer -->
                <Label Text="{Binding Name}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#1F2937"
                       HorizontalOptions="Center"
                       Margin="0,8,0,0"/>

                <!-- Email -->
                <Label Text="{Binding Email}"
                       FontSize="14"
                       TextColor="#6B7280"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- ── Card Saldo ─────────────────────────────────────────── -->
            <Border StrokeThickness="0" Padding="24" Margin="0,4,0,4">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3E64FF" Offset="0"/>
                        <GradientStop Color="#5B7FFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="6">
                    <Label Text="💰 Saldo Saya"
                           TextColor="White"
                           FontSize="13"/>
                    <Label Text="{Binding BalanceFormatted}"
                           TextColor="White"
                           FontSize="28"
                           FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Border>

            <!-- ── Info: Nama Lengkap ─────────────────────────────────── -->
            <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="👤 Nama Lengkap"
                           FontSize="12"
                           TextColor="#6B7280"/>
                    <Label Text="{Binding Name}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#1F2937"/>
                </VerticalStackLayout>
            </Border>

            <!-- ── Info: Email ────────────────────────────────────────── -->
            <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="📧 Email"
                           FontSize="12"
                           TextColor="#6B7280"/>
                    <Label Text="{Binding Email}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#1F2937"/>
                </VerticalStackLayout>
            </Border>

            <!-- ── Info: Role ─────────────────────────────────────────── -->
            <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="🎭 Role"
                           FontSize="12"
                           TextColor="#6B7280"/>
                    <Label Text="{Binding Role}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#1F2937"/>
                </VerticalStackLayout>
            </Border>

            <!-- ── Shortcut: Riwayat Pesanan ──────────────────────────── -->
            <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToOrderHistoryCommand}"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="📦 Riwayat Pesanan"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#3E64FF"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="→"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#3E64FF"
                           VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- ── Tombol Logout ──────────────────────────────────────── -->
            <Button Text="LOGOUT"
                    BackgroundColor="#EF4444"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="52"
                    Margin="0,8,0,24"
                    Command="{Binding LogoutCommand}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>