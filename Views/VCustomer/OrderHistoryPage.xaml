<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:utils="clr-namespace:AstroBoy.Utils"
             x:Class="AstroBoy.Views.VCustomer.OrderHistoryPage"
             Title="Riwayat Pesanan"
             BackgroundColor="#F8F9FF">

    <ContentPage.Resources>
        <utils:ItemImageConverter x:Key="ItemImageConverter" />
    </ContentPage.Resources>

    <Grid>

        <!-- ── Empty State ────────────────────────────────────────────────── -->
        <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="12"
                             Padding="32">
            <Label Text="📦"
                   FontSize="72"
                   HorizontalOptions="Center"/>
            <Label Text="Belum ada pesanan"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#1F2937"
                   HorizontalOptions="Center"/>
            <Label Text="Yuk mulai belanja!"
                   FontSize="14"
                   TextColor="#6B7280"
                   HorizontalOptions="Center"/>
            <Button Text="Mulai Belanja"
                    BackgroundColor="#3E64FF"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    Padding="28,12"
                    HorizontalOptions="Center"
                    Command="{Binding GoToHomeCommand}"/>
        </VerticalStackLayout>

        <!-- ── Daftar Order ───────────────────────────────────────────────── -->
        <CollectionView IsVisible="{Binding HasOrders}"
                        ItemsSource="{Binding Orders}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <BoxView HeightRequest="8" Color="Transparent"/>
            </CollectionView.Header>
            <CollectionView.Footer>
                <BoxView HeightRequest="16" Color="Transparent"/>
            </CollectionView.Footer>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="utils:OrderRecord">

                    <!-- Card order putih dengan shadow tipis -->
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            Margin="12,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#888888" Offset="0,2" Radius="4" Opacity="0.12"/>
                        </Border.Shadow>

                        <VerticalStackLayout>

                            <!-- Header card: OrderId, Tanggal, StoreSummary -->
                            <Border BackgroundColor="#F3F4F6"
                                    StrokeThickness="0"
                                    Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16,16,0,0"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding OrderLabel}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#6B7280"/>
                                    <Label Text="{Binding DateFormatted}"
                                           FontSize="12"
                                           TextColor="#6B7280"/>
                                    <Label Text="{Binding StoreSummary}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#1F2937"
                                           Margin="0,4,0,0"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Item list dalam order -->
                            <VerticalStackLayout Padding="12,10" Spacing="10"
                                                 BindableLayout.ItemsSource="{Binding Items}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="utils:OrderItemRecord">
                                        <Grid ColumnDefinitions="56,*,Auto"
                                              ColumnSpacing="10">

                                            <!-- Gambar produk 48x48 -->
                                            <Border Grid.Column="0"
                                                    WidthRequest="48"
                                                    HeightRequest="48"
                                                    StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8"/>
                                                </Border.StrokeShape>
                                                <Image Source="{Binding ImageSource, Converter={StaticResource ItemImageConverter}}"
                                                       Aspect="AspectFill"/>
                                            </Border>

                                            <!-- Nama produk + qty -->
                                            <VerticalStackLayout Grid.Column="1"
                                                                 VerticalOptions="Center"
                                                                 Spacing="2">
                                                <Label Text="{Binding ProductName}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="#1F2937"
                                                       LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding QtyLabel}"
                                                       FontSize="12"
                                                       TextColor="#6B7280"/>
                                            </VerticalStackLayout>

                                            <!-- Subtotal harga -->
                                            <Label Grid.Column="2"
                                                   Text="{Binding SubtotalFormatted}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="#3E64FF"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Separator garis -->
                            <BoxView HeightRequest="1"
                                     BackgroundColor="#E5E7EB"
                                     Margin="12,0"/>

                            <!-- Footer card: Total + Badge Selesai -->
                            <Grid Padding="12,10"
                                  ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding TotalFormatted, StringFormat='Total: {0}'}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937"
                                       VerticalOptions="Center"/>

                                <!-- Badge status (Selesai / Pending) -->
                                <Border Grid.Column="1"
                                        BackgroundColor="{Binding StatusBadgeBackground}"
                                        StrokeThickness="0"
                                        Padding="10,4"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <Label Text="{Binding StatusText}"
                                           FontSize="12"
                                           TextColor="{Binding StatusTextColor}"/>
                                </Border>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
