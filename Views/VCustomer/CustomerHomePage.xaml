<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:utils="clr-namespace:AstroBoy.Utils"
             x:Class="AstroBoy.Views.VCustomer.CustomerHomePage"
             x:Name="pageRoot"
             BackgroundColor="#F8F9FF">

    <ContentPage.Resources>
        <utils:ItemImageConverter x:Key="ItemImageConverter" />
    </ContentPage.Resources>

    <!-- ═══════════════════════════════════════════════════════════
         KONTEN UTAMA: Toast → Search → Filter Chip → Product Grid
    ════════════════════════════════════════════════════════════════ -->
    <Grid RowDefinitions="Auto,Auto,Auto,*"
          Padding="12,10,12,0"
          RowSpacing="10">

        <!-- ── Toast Notifikasi "Ditambahkan ke keranjang" ──────── -->
        <Border Grid.Row="0"
                IsVisible="{Binding IsToastVisible}"
                BackgroundColor="#22C55E"
                StrokeThickness="0"
                Padding="14,10"
                HorizontalOptions="Fill">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <Label Text="{Binding ToastMessage}"
                   TextColor="White"
                   FontSize="13"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
        </Border>

        <!-- ── Search Bar ──────────────────────────────────────── -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                StrokeThickness="1"
                Stroke="#E5E7EB"
                HeightRequest="46"
                Padding="12,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <!-- Icon search -->
                <Image Grid.Column="0"
                       Source="search.svg"
                       WidthRequest="18"
                       HeightRequest="18"
                       VerticalOptions="Center"/>

                <!-- Input pencarian, filter realtime saat mengetik -->
                <Entry Grid.Column="1"
                       Text="{Binding SearchQuery}"
                       Placeholder="Cari produk..."
                       PlaceholderColor="#9CA3AF"
                       BackgroundColor="Transparent"
                       TextColor="#1F2937"
                       FontSize="14"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- ── Filter Chip by Store (scroll horizontal) ───────── -->
        <ScrollView Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8"
                                   Padding="0,2"
                                   BindableLayout.ItemsSource="{Binding CategoryFilters}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <!-- Setiap chip warnanya reaktif terhadap IsSelected -->
                        <Border BackgroundColor="{Binding ChipBackground}"
                                StrokeThickness="0"
                                Padding="14,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <!-- Tap chip → kirim nama kategori ke SelectCategoryFilterCommand -->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference pageRoot}, Path=BindingContext.SelectCategoryFilterCommand}"
                                    CommandParameter="{Binding Name}"/>
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Name}"
                                   TextColor="{Binding ChipTextColor}"
                                   FontSize="13"
                                   FontAttributes="Bold"/>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- ── Product Grid 2 Kolom ───────────────────────────── -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding FilteredProducts}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="8"
                                 VerticalItemSpacing="10"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- Card produk: rounded corner, shadow tipis -->
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            Margin="0,0,0,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,2"
                                    Radius="8"
                                    Opacity="0.07"/>
                        </Border.Shadow>

                        <Grid RowDefinitions="130,Auto,Auto,Auto,Auto">

                            <!-- Gambar produk: full width, sudut atas rounded, tap → detail -->
                            <Border Grid.Row="0"
                                    StrokeThickness="0"
                                    HeightRequest="130">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12,12,0,0"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference pageRoot}, Path=BindingContext.OpenProductDetailCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Image Source="{Binding ImageSource, Converter={StaticResource ItemImageConverter}}"
                                       Aspect="AspectFill"/>
                            </Border>

                            <!-- Nama produk -->
                            <Label Grid.Row="1"
                                   Text="{Binding ProductName}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#1F2937"
                                   Margin="10,10,10,2"
                                   LineBreakMode="TailTruncation"/>

                            <!-- Nama store (kecil, abu) -->
                            <Label Grid.Row="2"
                                   Text="{Binding StoreName}"
                                   FontSize="12"
                                   TextColor="#6B7280"
                                   Margin="10,0,10,4"/>

                            <!-- Harga (bold, biru) -->
                            <Label Grid.Row="3"
                                   Text="{Binding PriceFormatted}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#3E64FF"
                                   Margin="10,0,10,8"/>

                            <!-- Tombol [-] counter [+] -->
                            <Grid Grid.Row="4"
                                  ColumnDefinitions="*,Auto,*"
                                  Margin="8,0,8,12">

                                <!-- Tombol kurangi -->
                                <Button Grid.Column="0"
                                        Text="-"
                                        Command="{Binding Source={x:Reference pageRoot}, Path=BindingContext.RemoveFromCartCommand}"
                                        CommandParameter="{Binding .}"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        CornerRadius="16"
                                        BackgroundColor="#3E64FF"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Padding="0"
                                        HorizontalOptions="Center"/>

                                <!-- Counter quantity -->
                                <Label Grid.Column="1"
                                       Text="{Binding QuantityLabel}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937"
                                       WidthRequest="30"
                                       HorizontalTextAlignment="Center"
                                       VerticalOptions="Center"/>

                                <!-- Tombol tambah -->
                                <Button Grid.Column="2"
                                        Text="+"
                                        Command="{Binding Source={x:Reference pageRoot}, Path=BindingContext.AddToCartCommand}"
                                        CommandParameter="{Binding .}"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        CornerRadius="16"
                                        BackgroundColor="#3E64FF"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Padding="0"
                                        HorizontalOptions="Center"/>
                            </Grid>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>

