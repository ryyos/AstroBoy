<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:utils="clr-namespace:AstroBoy.Utils"
             x:Class="AstroBoy.Views.VCustomer.ProductDetailPage"
             x:Name="pageRoot"
             Title="Detail Produk"
             BackgroundColor="#F8F9FF">

    <ContentPage.Resources>
        <utils:ItemImageConverter x:Key="ItemImageConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- ── Gambar Produk (besar) ─────────────────────────── -->
                <Border StrokeThickness="0" HeightRequest="280">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0,0,24,24"/>
                    </Border.StrokeShape>
                    <Image Source="{Binding ImageSource, Converter={StaticResource ItemImageConverter}}"
                           Aspect="AspectFill"
                           BackgroundColor="#E5E7EB"/>
                </Border>

                <!-- ── Info Produk ───────────────────────────────────── -->
                <VerticalStackLayout Padding="20,20,20,12" Spacing="12">

                    <!-- Toast "Ditambahkan ke keranjang" -->
                    <Border IsVisible="{Binding IsToastVisible}"
                            BackgroundColor="#22C55E"
                            StrokeThickness="0"
                            Padding="14,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Label Text="✓ Ditambahkan ke keranjang"
                               TextColor="White"
                               FontSize="13"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                    </Border>

                    <!-- Nama Produk -->
                    <Label Text="{Binding ProductName}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1F2937"/>

                    <!-- Harga -->
                    <Label Text="{Binding PriceFormatted}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#3E64FF"/>

                    <!-- Asal Toko -->
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="14,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="🏪"  FontSize="18" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Dijual oleh"
                                       FontSize="11"
                                       TextColor="#6B7280"/>
                                <Label Text="{Binding StoreName}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Stok & Kategori -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="White" StrokeThickness="0" Padding="14,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="📦 Stok" FontSize="11" TextColor="#6B7280"/>
                                <Label Text="{Binding StockText}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="White" StrokeThickness="0" Padding="14,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="🏷️ Kategori" FontSize="11" TextColor="#6B7280"/>
                                <Label Text="{Binding Category}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Footer: counter [−] qty [+] + tombol Add to Cart ── -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="20,14,20,28">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20,20,0,0"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-2" Radius="12" Opacity="0.08"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">

                <!-- Counter -->
                <Grid Grid.Column="0"
                      ColumnDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="4"
                      VerticalOptions="Center">
                    <Button Grid.Column="0"
                            Text="−"
                            Command="{Binding RemoveFromCartCommand}"
                            WidthRequest="40" HeightRequest="40"
                            CornerRadius="20"
                            BackgroundColor="#E5E7EB"
                            TextColor="#1F2937"
                            FontAttributes="Bold"
                            FontSize="18"
                            Padding="0"/>
                    <Label Grid.Column="1"
                           Text="{Binding QuantityLabel}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1F2937"
                           WidthRequest="36"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"/>
                    <Button Grid.Column="2"
                            Text="+"
                            Command="{Binding AddToCartCommand}"
                            WidthRequest="40" HeightRequest="40"
                            CornerRadius="20"
                            BackgroundColor="#3E64FF"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="18"
                            Padding="0"/>
                </Grid>

                <!-- Tombol Add to Cart -->
                <Button Grid.Column="1"
                        Text="+ Tambah ke Keranjang"
                        Command="{Binding AddToCartCommand}"
                        BackgroundColor="#3E64FF"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="12"
                        HeightRequest="48"/>

            </Grid>
        </Border>

    </Grid>
</ContentPage>
