<ContentPage
    x:Class="AstroBoy.Views.VAdmin.AdminCustomerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AstroBoy.ViewModels.AdminViewModel"
    Title="Manage Customer">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Customer Management"
               FontSize="24"
               FontAttributes="Bold"/>

        <Button Text="Add Customer" Clicked="OnAddCustomerClicked"/>

        <CollectionView ItemsSource="{Binding Customers}">
            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Frame Padding="10" Margin="0,5">
                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout>
                                <Label Text="{Binding Name}"
                                       TextColor="Black"
                                       FontAttributes="Bold"/>
                                
                                <Label Text="{Binding Role}" 
                                       TextColor="Black"/>
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="10">
                                <Button Text="Edit"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminCustomerViewModel}}, Path=EditCustomerCommand}"
                                        CommandParameter="{Binding .}"
                                        />
                                <Button Text="Delete"
                                        BackgroundColor="Red"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminCustomerViewModel}}, Path=DeleteCustomerCommand}"
                                        CommandParameter="{Binding .}"
                                        TextColor="White"/>
                            </HorizontalStackLayout>

                        </Grid>
                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>