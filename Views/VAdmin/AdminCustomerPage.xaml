<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AstroBoy.Views.VAdmin.AdminCustomerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5F7FB">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="18">

                <!-- HEADER -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="Customers"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#111827"/>

                    <Label Text="Manage all registered customers"
                           FontSize="13"
                           TextColor="#6B7280"/>
                </VerticalStackLayout>


                <!-- SEARCH -->
                <Frame CornerRadius="16"
                       Padding="12"
                       BackgroundColor="White"
                       HasShadow="True">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">

                        <Image Source="search.png"
                               WidthRequest="18"
                               HeightRequest="18"
                               VerticalOptions="Center"
                               Opacity="0.6"/>

                        <Entry Placeholder="Search customer..."
                               Text="{Binding SearchText}"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"
                               FontSize="14"/>

                    </Grid>
                </Frame>


                <!-- LIST -->
                <CollectionView ItemsSource="{Binding Customers}"
                                SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Frame Margin="0,6"
                                   Padding="14"
                                   CornerRadius="18"
                                   BackgroundColor="White"
                                   HasShadow="True">

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="12">

                                    <!-- Avatar -->
                                    <Frame WidthRequest="44"
                                           HeightRequest="44"
                                           CornerRadius="22"
                                           BackgroundColor="#3D63FF"
                                           Padding="0"
                                           VerticalOptions="Center"
                                           HasShadow="False">

                                        <Label Text="{Binding Initial}"
                                               TextColor="White"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>


                                    <!-- Info -->
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="2"
                                                         VerticalOptions="Center">

                                        <Label Text="{Binding Name}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               TextColor="#111827"/>

                                        <Label Text="{Binding Email}"
                                               FontSize="12"
                                               TextColor="#6B7280"/>
                                    </VerticalStackLayout>


                                    <!-- Actions -->
                                    <HorizontalStackLayout Grid.Column="2"
                                                           Spacing="8"
                                                           VerticalOptions="Center">

                                        <Button Text="Edit"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCustomerCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#EEF2FF"
                                                TextColor="#3D63FF"
                                                CornerRadius="10"
                                                FontSize="12"
                                                HeightRequest="32"/>

                                        <Button Text="Delete"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCustomerCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FEE2E2"
                                                TextColor="#DC2626"
                                                CornerRadius="10"
                                                FontSize="12"
                                                HeightRequest="32"/>

                                    </HorizontalStackLayout>

                                </Grid>

                            </Frame>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>


        <!-- FLOATING ADD BUTTON -->
        <Button Text="+"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                BackgroundColor="#3D63FF"
                TextColor="White"
                FontSize="24"
                Command="{Binding AddCustomerCommand}"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20">

            <Button.Shadow>
                <Shadow Brush="#000000"
                        Opacity="0.25"
                        Radius="10"
                        Offset="0,4"/>
            </Button.Shadow>

        </Button>

    </Grid>

</ContentPage>