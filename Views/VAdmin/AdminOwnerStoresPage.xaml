<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             x:Name="ThisPage"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AstroBoy.Views.VAdmin.AdminOwnerStoresPage">

    <CollectionView ItemsSource="{Binding Stores}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="10" Padding="10">
                    <VerticalStackLayout>

                        <Label Text="{Binding Name}" FontSize="18" TextColor="Black"/>
                        <Button 
                            Text="View Items"
                            TextColor="Black"
                            Command="{Binding BindingContext.ViewItemsCommand, Source={x:Reference Name=ThisPage}}"
                            CommandParameter="{Binding .}" />

                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>