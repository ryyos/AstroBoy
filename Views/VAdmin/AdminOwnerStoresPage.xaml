<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AstroBoy.Views.VAdmin.AdminOwnerStoresPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5F7FB">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="18">

                <!-- HEADER -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="Stores"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#111827"/>

                    <Label Text="All stores owned by selected owner"
                           FontSize="13"
                           TextColor="#6B7280"/>
                </VerticalStackLayout>


                <!-- SUMMARY CARD -->
                <Frame CornerRadius="18"
                       Padding="16"
                       BackgroundColor="#3D63FF"
                       HasShadow="False">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Total Stores"
                               FontSize="13"
                               TextColor="#E0E7FF"/>

                        <Label Text="{Binding Stores.Count}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="White"/>
                    </VerticalStackLayout>
                </Frame>


                <!-- STORE LIST -->
                <CollectionView ItemsSource="{Binding Stores}"
                                SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Frame Margin="0,6"
                                Padding="14"
                                CornerRadius="18"
                                BackgroundColor="White"
                                HasShadow="True">

                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewItemsCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="12">

                                    <!-- Icon -->
                                    <Frame WidthRequest="44"
                                        HeightRequest="44"
                                        CornerRadius="22"
                                        BackgroundColor="#EEF2FF"
                                        Padding="0"
                                        VerticalOptions="Center"
                                        HasShadow="False">

                                        <Label Text="🏪"
                                            FontSize="18"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"/>
                                    </Frame>

                                    <!-- Info -->
                                    <VerticalStackLayout Grid.Column="1"
                                                        Spacing="2"
                                                        VerticalOptions="Center">

                                        <Label Text="{Binding Name}"
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            TextColor="#111827"/>
                                    </VerticalStackLayout>

                                    <!-- Stats -->
                                    <VerticalStackLayout Grid.Column="2"
                                                        Spacing="2"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="End">

                                        <Label Text="{Binding ItemCount}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="#3D63FF"
                                            HorizontalTextAlignment="End"/>

                                        <Label Text="items"
                                            FontSize="11"
                                            TextColor="#6B7280"
                                            HorizontalTextAlignment="End"/>
                                    </VerticalStackLayout>

                                </Grid>

                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>