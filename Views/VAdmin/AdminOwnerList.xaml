<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AstroBoy.Views.VAdmin.AdminOwnerList"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5F7FB">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="18">

                <!-- HEADER -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="Owners"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#111827"/>

                    <Label Text="Manage store owners"
                           FontSize="13"
                           TextColor="#6B7280"/>
                </VerticalStackLayout>

                <!-- LIST -->
                <CollectionView ItemsSource="{Binding Owners}"
                                SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Frame Margin="0,6"
                                   Padding="14"
                                   CornerRadius="18"
                                   BackgroundColor="White"
                                   HasShadow="True">

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="12">

                                    <!-- Avatar -->
                                    <Frame WidthRequest="44"
                                           HeightRequest="44"
                                           CornerRadius="22"
                                           BackgroundColor="#3D63FF"
                                           Padding="0"
                                           VerticalOptions="Center"
                                           HasShadow="False">

                                        <Label Text="{Binding Initial}"
                                               TextColor="White"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>


                                    <!-- Info -->
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="2"
                                                         VerticalOptions="Center">

                                        <Label Text="{Binding Name}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               TextColor="#111827"/>

                                        <Label Text="{Binding Email}"
                                               FontSize="12"
                                               TextColor="#6B7280"/>
                                    </VerticalStackLayout>


                                    <!-- Action -->
                                    <Button Grid.Column="2"
                                            Text="Stores"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewStoresCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#EEF2FF"
                                            TextColor="#3D63FF"
                                            CornerRadius="10"
                                            FontSize="12"
                                            HeightRequest="32"
                                            VerticalOptions="Center"/>

                                </Grid>

                            </Frame>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>