<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AstroBoy.ViewModels.AdminViewModel"
             x:Name="PageRoot"
             x:Class="AstroBoy.Views.VAdmin.AdminOwnerList">

    <CollectionView ItemsSource="{Binding Owners}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="10" Padding="10">
                    <VerticalStackLayout>

                        <Label Text="{Binding Name}" FontSize="18" TextColor="Black"/>
                        <Label Text="{Binding Email}" FontSize="12" TextColor="Black"/>

                        <Button Text="View Stores"
                            Command="{Binding BindingContext.ViewStoresCommand, Source={x:Reference PageRoot}}"
                            CommandParameter="{Binding .}" />

                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>