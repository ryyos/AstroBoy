<ContentPage
    x:Class="AstroBoy.Views.VAdmin.AdminDashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Admin Dashboard">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="Dashboard"
               FontSize="24"
               FontAttributes="Bold"/>

        <Grid ColumnDefinitions="*,*"
              RowDefinitions="Auto,Auto"
              RowSpacing="15"
              ColumnSpacing="15">

            <Frame Grid.Row="0" Grid.Column="0" Padding="15">
                <VerticalStackLayout>
                    <Label Text="Customers" TextColor="Black" FontAttributes="Bold"/>
                    <Label Text="{Binding TotalCustomers}"
                           FontSize="20"
                           TextColor="Black"
                           FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>

            <Frame Grid.Row="0" Grid.Column="1" Padding="15">
                <VerticalStackLayout>
                    <Label Text="Stores" TextColor="Black" FontAttributes="Bold"/>
                    <Label Text="{Binding TotalStores}"
                           FontSize="20"
                           TextColor="Black"
                           FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>

            <Frame Grid.Row="1" Grid.Column="0" Padding="15">
                <VerticalStackLayout>
                    <Label Text="Owners" TextColor="Black" FontAttributes="Bold"/>
                    <Label Text="{Binding TotalOwners}"
                           FontSize="20"
                           TextColor="Black"
                           FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>

            <Frame Grid.Row="1" Grid.Column="1" Padding="15">
                <VerticalStackLayout>
                    <Label Text="Items" TextColor="Black" FontAttributes="Bold"/>
                    <Label Text="{Binding TotalItems}"
                           FontSize="20"
                           TextColor="Black"
                           FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>

        </Grid>

    </VerticalStackLayout>
</ContentPage>