<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AstroBoy.Views.Auth.RegisterPage"
             BackgroundColor="White"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <!-- Latar Belakang Biru Header -->
        <VerticalStackLayout HeightRequest="220" VerticalOptions="Start" BackgroundColor="#3d63ff">

            <!-- Header Astro Boy -->
            <VerticalStackLayout Spacing="0" HorizontalOptions="Center" Margin="0,50,0,0">
                <Label Text="ASTRO"
                       TextColor="White"
                       FontSize="36"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
                <Label Text="BOY APP"
                       TextColor="White"
                       Opacity="0.8"
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       CharacterSpacing="5"
                       Margin="0,-5,0,0" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Area Form Putih -->
        <Border Margin="0, 150, 0, 0" BackgroundColor="White" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30,30,0,0" />
            </Border.StrokeShape>

            <ScrollView>
                <VerticalStackLayout Padding="30" Spacing="15">

                    <Label Text="REGISTER"
                           FontSize="24"
                           TextColor="#3d63ff"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           Margin="0,10,0,20" />

                    <!-- Input Name -->
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Name" FontSize="11" TextColor="#3d63ff" />
                        <Entry Placeholder="Name"
                               Text="{Binding Name}"
                               BackgroundColor="Transparent"
                               TextColor="Black" />
                        <BoxView HeightRequest="1" Color="#3d63ff" Margin="0,5,0,0" />
                    </VerticalStackLayout>

                    <!-- Input Email -->
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Email" FontSize="11" TextColor="#3d63ff" />
                        <Entry Placeholder="example@email.com"
                               Text="{Binding _Email}"
                               Keyboard="Email"
                               BackgroundColor="Transparent"
                               TextColor="Black" />
                        <BoxView HeightRequest="1" Color="#3d63ff" Margin="0,5,0,0" />
                    </VerticalStackLayout>

                    <!-- Input Password -->
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Password" FontSize="11" TextColor="#3d63ff" />
                        <Grid>
                            <Entry Placeholder="********"
                                   IsPassword="True"
                                   Text="{Binding Password}"
                                   BackgroundColor="Transparent"
                                   TextColor="Black" />
                            <Label Text="?" TextColor="#A1A1A1" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,5,0" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#3d63ff" Margin="0,5,0,0" />
                    </VerticalStackLayout>

                    <!-- Pilihan Role -->
                    <VerticalStackLayout Spacing="0" Margin="0,10,0,0">
                        <Label Text="Select Role" FontSize="11" TextColor="#3d63ff" />
                        <Picker Title="Pilih Role"
                                TitleColor="#A1A1A1"
                                TextColor="Black"
                                BackgroundColor="Transparent"
                                SelectedItem="{Binding Role}">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Customer</x:String>
                                    <x:String>Owner</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                        <BoxView HeightRequest="1" Color="#3d63ff" Margin="0,5,0,0" />
                    </VerticalStackLayout>

                    <!-- Pesan Error -->
                    <Label Text="{Binding ErrorMessage}" TextColor="Red" FontSize="12" HorizontalOptions="Center"/>

                    <!-- Tombol Signup -->
                    <Button Text="SIGNUP"
                            Command="{Binding RegisterCommand}"
                            TextColor="White"
                            BackgroundColor="#3d63ff"
                            CornerRadius="25"
                            HeightRequest="50"
                            FontAttributes="Bold"
                            Margin="0,20,0,0"
                            WidthRequest="200"
                            HorizontalOptions="Center" />

                    <!-- Link ke Login -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,20,0,0">
                        <Label Text="Already have an account?" FontSize="10" TextColor="#3d63ff"/>
                        <Label Text="Sign In" TextColor="#3d63ff" FontAttributes="Bold" FontSize="10">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>